# URL base del backend (NestJS). En desarrollo local, la API corre en el puerto 3000.
# Las server actions ya agregan el prefijo /api, así que va sin barra final.
ADDRESS_SERVER=http://localhost:3000

# Secreto para firmar la sesión (NextAuth.js). Generá uno con:
#   openssl rand -base64 32
AUTH_SECRET=

# Discord OAuth — portal: https://discord.com/developers/applications
# La Redirect URI de la app de Discord debe apuntar al backend:
#   http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# GitHub OAuth (opcional, proveedor secundario de login social).
# Si se dejan vacíos, el login con GitHub queda deshabilitado.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
